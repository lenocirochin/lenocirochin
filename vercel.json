{
  "redirects": [
    {
      "source": "/nosotros",
      "destination": "/#nosotros",
      "statusCode": 301
    },
    {
      "source": "/nosotros/",
      "destination": "/#nosotros",
      "statusCode": 301
    },
    {
      "source": "/servicios",
      "destination": "/#servicios",
      "statusCode": 301
    },
    {
      "source": "/servicios/",
      "destination": "/#servicios",
      "statusCode": 301
    },
    {
      "source": "/contacto",
      "destination": "/#contacto",
      "statusCode": 301
    },
    {
      "source": "/contacto/",
      "destination": "/#contacto",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
